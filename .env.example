# ---------------------------------------------------------------------------
# Hishab — copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database (Postgres 16) ------------------------------------------------
POSTGRES_USER=hishab
POSTGRES_PASSWORD=hishab
POSTGRES_DB=hishab
# Host ports are non-default so Hishab never collides with another local Postgres/Redis.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://hishab:hishab@localhost:5433/hishab?schema=public

# --- Redis 7 (BullMQ) ------------------------------------------------------
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# --- API -------------------------------------------------------------------
API_PORT=4000
# CORS allowlist, comma separated
CORS_ORIGINS=http://localhost:3000

# openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Envelope encryption key for InboundMessage.bodyRaw (M7+). openssl rand -base64 32
INGEST_ENCRYPTION_KEY=change-me-32-byte-base64

# --- Web -------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Telegram credit-card reminders (M36) ----------------------------------
# The official Hishab bot. Full control of that bot, so it lives only here and
# in the server's secret file — never in the repository, never in a log.
# Rotate with /revoke in BotFather if it is ever exposed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Header Telegram must present on every webhook call. openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
APP_URL=http://localhost:3000

# --- AI (server-side only, M17) --------------------------------------------
ANTHROPIC_API_KEY=

# --- Inbound ingestion webhook (M7) ----------------------------------------
# The per-workspace secret is derived from this, so the endpoint is closed
# until it is set — deliberately, rather than falling back to a default that
# would make every workspace's webhook guessable. openssl rand -hex 32
INGESTION_WEBHOOK_SECRET=
# Set during a rotation: both are accepted until every forwarder has caught up.
INGESTION_WEBHOOK_SECRET_PREVIOUS=
INGESTION_THROTTLE_LIMIT=60
API_PUBLIC_URL=http://localhost:4000
# Where an SMS forwarder posts. A separate host on purpose: it serves the one
# webhook route and 404s everything else, so the secret on somebody's phone is a
# key to one door rather than to the whole API.
INGEST_PUBLIC_URL=https://sms.takatracker.com

# --- Outbound email (M30) --------------------------------------------------
# With no SMTP_HOST the mailer writes the message, link included, to the log.
# That keeps verification and password reset fully usable in development and
# logs a warning in production rather than failing silently.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Hishab <no-reply@takatracker.com>

# --- Attachments (M3) -------------------------------------------------------
# Where receipt photos are written. Absolute path. Unset, it is
# /var/lib/hishab/attachments in production and ./.data/attachments otherwise.
# The bytes live on disk; only metadata is in the database.
ATTACHMENTS_DIR=
