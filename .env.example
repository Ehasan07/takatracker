# ---------------------------------------------------------------------------
# Hishab — copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database (Postgres 16) ------------------------------------------------
POSTGRES_USER=hishab
POSTGRES_PASSWORD=hishab
POSTGRES_DB=hishab
# Host ports are non-default so Hishab never collides with another local Postgres/Redis.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://hishab:hishab@localhost:5433/hishab?schema=public

# --- Redis 7 (BullMQ) ------------------------------------------------------
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# --- API -------------------------------------------------------------------
API_PORT=4000
# CORS allowlist, comma separated
CORS_ORIGINS=http://localhost:3000

# openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Envelope encryption key for InboundMessage.bodyRaw (M7+). openssl rand -base64 32
INGEST_ENCRYPTION_KEY=change-me-32-byte-base64

# --- Web -------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Telegram credit-card reminders (M36) ----------------------------------
# The official Hishab bot. Full control of that bot, so it lives only here and
# in the server's secret file — never in the repository, never in a log.
# Rotate with /revoke in BotFather if it is ever exposed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Header Telegram must present on every webhook call. openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
APP_URL=http://localhost:3000

# --- AI (server-side only, M17) --------------------------------------------
ANTHROPIC_API_KEY=
