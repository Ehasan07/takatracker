// Hishab — server schema.
//
// Money is ALWAYS BigInt poisha (1/100 BDT). No Float or Decimal anywhere.
//
// Tenancy: every row that belongs to a customer carries `workspaceId`, and that
// column — never `userId` — is what the repository layer filters on. `userId`
// survives only where it records *who did something*. See docs/PLAN.md §3.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  /// The mobile number, canonical `01XXXXXXXXX` — `storablePhone` runs on every
  /// write. Unique so it can be signed in with; nullable so the accounts that
  /// predate the field are asked in the app rather than locked out by a
  /// migration. Postgres allows many NULLs under a unique index.
  phone        String?  @unique
  passwordHash String
  name         String
  /// Display language. Currency and the ledger day belong to the workspace.
  locale       String   @default("bn")
  /// IOS | ANDROID | DESKTOP, as answered at signup. Null for older accounts.
  device       String?
  /// When to deliver reminders to this person, which need not match the
  /// workspace's accounting timezone.
  notifyTimezone String @default("Asia/Dhaka")
  /// null until the address is proven. Unverified accounts still work — locking
  /// somebody out of their own books over an undelivered email is worse than
  /// the risk — but the nag stays until this is set.
  emailVerifiedAt DateTime?
  /// When this person asked for their account to be erased, and when the
  /// sweep may act on it. The gap between the two is the grace period: a
  /// deletion nobody can undo, taken in one tap on a phone, is a support
  /// request nobody can answer. Signing in cancels it.
  deletionRequestedAt DateTime?
  deletionScheduledFor DateTime?
  /**
   * Platform operator, not a workspace role.
   *
   * A super admin can read across every tenant, which is a deliberate hole in
   * the guard that protects all of them. It is a column on `User` rather than a
   * `Membership` role precisely so it can never be granted by workspace
   * administration — inviting somebody to a workspace must not be able to make
   * them an operator of the platform.
   */
  isSuperAdmin    Boolean   @default(false)
  /// Bumped whenever every session must die — a password reset, an admin
  /// lockout. Access tokens carry the value they were minted with, so a stolen
  /// one stops working the moment this moves rather than surviving its
  /// remaining fifteen minutes. Refresh families are revoked separately; this
  /// closes the access-token window they cannot reach.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships      Membership[]
  emailTokens      EmailToken[]
  ownedWorkspaces  Workspace[]    @relation("WorkspaceOwner")
  createdTxns      Transaction[]  @relation("TransactionAuthor")
  refreshTokens    RefreshToken[]
  sentInvitations  Invitation[]   @relation("InvitationSender")
  telegram         TelegramConnection[]
  auditEvents      AuditEvent[]         @relation("AuditActor")
  statementShares  StatementShare[]     @relation("StatementShareAuthor")
  splitGroups      SplitGroup[]         @relation("SplitGroupAuthor")
}

/// Rotating refresh tokens. A whole family is revoked when a used token is
/// replayed (reuse detection, spec §9). A session belongs to a person, not to
/// a tenant, so this table has no `workspaceId`.
model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  familyId   String
  tokenHash  String    @unique
  deviceId   String?
  userAgent  String?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  usedAt     DateTime?
  revokedAt  DateTime?
  replacedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([expiresAt])
}

/// How a code reached the person. Email is free; an SMS costs money and is
/// capped, which cannot be counted without recording which is which.
enum TokenChannel {
  EMAIL
  SMS
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  /// A code that signs somebody in, worth as much as the password. Audited as
  /// its own action, because unlike a reset it leaves the account looking
  /// untouched to the person who owns it.
  SIGN_IN
}

/// One-shot links sent by email.
///
/// Only the hash is stored, exactly as with refresh tokens: a leaked database
/// must not hand somebody a working password-reset link. Rows are kept after
/// use so a replay can be told apart from an expired link, which changes what
/// the user is told.
model EmailToken {
  id        String            @id @default(cuid())
  userId    String
  purpose   EmailTokenPurpose
  /// EMAIL unless the code was texted. Read by the daily SMS cap.
  channel   TokenChannel      @default(EMAIL)
  tokenHash String            @unique
  /// The six-digit code carried in the same email. Not unique — six digits
  /// collide, so the lookup is by (userId, purpose) and the hash is compared
  /// afterwards. Null on rows issued before codes existed.
  codeHash  String?
  /// Wrong guesses against `codeHash`. The code burns at five; see the migration.
  attempts  Int               @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())
  /// Where it was requested from, for the audit trail on a reset.
  requestIp String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([userId, purpose, createdAt])
  @@index([userId, channel, createdAt])
  @@index([expiresAt])
}

/// What a shared statement covers. The link is scoped to one of these and one
/// id; there is no code path from a share token to anything else.
enum StatementKind {
  PERSON
  LOAN
  SAVINGS
  INSURANCE
  /// A whole trip or event: what it cost and who carried what share of it.
  GROUP
  /// One account's own ledger, in running-balance form — the document a bank
  /// issues. Shared with a lender, a landlord or an auditor who needs to see
  /// the movements on one account and nothing else in the books.
  ACCOUNT
}

/// A statement somebody outside the app can open, print, and nothing more.
///
/// The window is stored rather than passed in the URL, so the person holding a
/// link to March cannot edit it into a link to everything. Only the token's
/// hash is kept, exactly as with refresh tokens: a leaked backup must not hand
/// anybody a working link.
model StatementShare {
  id          String        @id @default(cuid())
  workspaceId String
  kind        StatementKind
  subjectId   String
  /// Null means the whole life of the subject.
  fromDate    DateTime?     @db.Date
  toDate      DateTime?     @db.Date
  tokenHash   String        @unique
  /// The owner's own note — "for BRAC Bank", "March quarter".
  label       String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdByUserId String?
  /// There is no login on the far side, so the link is the credential. These
  /// are how the owner notices a link being read more than they expected.
  viewCount   Int           @default(0)
  lastViewedAt DateTime?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// The link outlives whoever made it: removing a colleague must neither
  /// delete a customer's statement nor be blocked by one.
  createdBy User?     @relation("StatementShareAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, kind, subjectId])
  @@index([expiresAt])
}

enum FeatureKind {
  /// A ceiling: 5 accounts, 300 transactions a month. `null` means unlimited.
  LIMIT
  /// On or off. 0 is off, anything else is on.
  FLAG
  /// A ceiling that is consumed and refills each period.
  QUOTA
}

enum MeterPeriod {
  /// Counts everything ever — storage, member seats.
  LIFETIME
  /// Resets on the first of the workspace's month.
  MONTHLY
  DAILY
}

/**
 * What a package can sell, as data.
 *
 * This used to be a TypeScript union in `packages/core/entitlements.ts`, which
 * meant adding a feature was a code change and a deployment — so a super admin
 * could never assemble a Custom package at runtime, which is the whole point of
 * having packages. The code now holds the *defaults* and seeds them at boot; the
 * database holds the catalogue.
 *
 * `key` stays a string rather than an enum for the same reason: an enum would
 * put the list back in a migration.
 */
model Feature {
  key       String      @id
  label     String
  labelBn   String
  kind      FeatureKind
  /// 'count', 'per-month', 'tokens', 'mb' — shown next to the number.
  unit      String
  /// Which period a QUOTA refills on. Ignored for LIMIT and FLAG.
  period    MeterPeriod @default(LIFETIME)
  /// Grouping for the admin screen: 'core', 'ingest', 'ai', 'integrations'.
  category  String      @default("core")
  /// False once a feature is retired: existing plans keep it, nothing new sells
  /// it. Deleting the row instead would silently drop a limit somebody is on.
  isActive  Boolean     @default(true)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  planFeatures PlanFeature[]
  overrides    WorkspaceFeatureOverride[]
  meters       UsageMeter[]
}

/**
 * What a workspace has actually consumed.
 *
 * Nine of the twelve features could not be enforced because nothing counted
 * them — a limit nobody measures is a promise, not a control. Writes happen
 * where the work happens; `assertWithinLimit` reads from here.
 *
 * `periodKey` is the bucket: 'lifetime', '2026-08', or '2026-08-10'. Storing it
 * as text rather than a date range keeps the unique index simple and makes a
 * month's row obvious when reading the table by hand.
 */
model UsageMeter {
  id          String   @id @default(cuid())
  workspaceId String
  featureKey  String
  periodKey   String
  value       BigInt   @default(0)
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  feature   Feature   @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@unique([workspaceId, featureKey, periodKey])
  @@index([workspaceId, featureKey])
}

// ---------------------------------------------------------------------------
// Plans & entitlements
//
// What each plan includes lives in `packages/core/entitlements.ts`, not here.
// The API upserts these rows from that definition at boot, so changing a tier
// is a pull request rather than a schema change.
// ---------------------------------------------------------------------------

enum BillingInterval {
  MONTHLY
  YEARLY
}

model Plan {
  id         String          @id @default(cuid())
  code       String          @unique
  name       String
  /// Integer minor units, like every other amount in the system.
  priceMinor BigInt          @default(0)
  /// The same bundle billed yearly, usually at a discount. Null = monthly only.
  priceYearlyMinor BigInt?
  currency   String          @default("BDT")
  interval   BillingInterval @default(MONTHLY)
  isPublic   Boolean         @default(true)
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  features   PlanFeature[]
  workspaces Workspace[]
}

model PlanFeature {
  id         String @id @default(cuid())
  planId     String
  featureKey String
  /// null = unlimited. For a flag, 0 is off.
  limitValue Int?

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@unique([planId, featureKey])
}

/// A per-workspace grant or restriction that beats the plan. Support uses this
/// to hand out an owner-only feature, or to widen a limit temporarily.
model WorkspaceFeatureOverride {
  id          String    @id @default(cuid())
  workspaceId String
  featureKey  String
  limitValue  Int?
  expiresAt   DateTime?
  note        String?
  createdAt   DateTime  @default(now())

  /// Who granted it. A support tool with no attribution is a liability.
  grantedByUserId String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  feature   Feature   @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@unique([workspaceId, featureKey])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

enum WorkspaceStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

/// The tenant. One per account today; the model exists so household and team
/// sharing is a feature flag later rather than a migration.
model Workspace {
  id           String          @id @default(cuid())
  name         String
  ownerUserId  String
  planId       String?
  status       WorkspaceStatus @default(ACTIVE)
  /// Base currency for every amount in this workspace.
  currency     String          @default("BDT")
  /// Which language this workspace's screens, categories and reports render in.
  locale       String          @default("bn")
  translations WorkspaceTranslation[]
  migrations   MigrationBatch[]
  obligations  AssetObligation[]
  taxProfile   TaxProfile?
  /// Defines the ledger day. All date arithmetic resolves against this.
  timezone     String          @default("Asia/Dhaka")
  trialEndsAt  DateTime?
  /// Days of notice before a credit-card due date, unless a card overrides it.
  creditCardReminderLeadDays Int     @default(7)
  /// Recording money into a card mutes that cycle. On by default; the manual
  /// control stays either way.
  autoMuteOnCardPayment      Boolean @default(true)
  /// Whether this workspace's messages may be sent to a language model to have
  /// a category and an account suggested.
  ///
  /// Off by default and per workspace, because turning it on means somebody
  /// else's SMS leaves this server. That is a decision for the person whose
  /// messages they are, not a default somebody discovers later.
  aiSuggestEnabled Boolean @default(false)
  /// Units this workspace added to the quantity field's suggestions. The eight
  /// common ones ship in the client and are not stored here; this is only what
  /// somebody added themselves. Suggestions, never a constraint — the field
  /// stays free text whatever is in this list.
  quantityUnits              String[] @default([])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?

  owner        User          @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  plan         Plan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  overrides    WorkspaceFeatureOverride[]
  memberships  Membership[]
  invitations  Invitation[]
  telegram     TelegramConnection[]
  cardCycles   CardReminderCycle[]
  auditEvents  AuditEvent[]
  loans        Loan[]
  loanPayments LoanPayment[]
  loanAccruals LoanInterestAccrual[]
  usageMeters  UsageMeter[]
  mailAccounts MailAccount[]
  smsGateways  SmsGateway[]
  importBatches ImportBatch[]
  attachments   Attachment[]
  ingestionMessages IngestionMessage[]
  transactionDrafts TransactionDraft[]
  mailMessages      MailMessage[]
  tags              Tag[]
  transactionTags   TransactionTag[]
  statementShares StatementShare[]
  splitGroups         SplitGroup[]
  splitGroupMembers   SplitGroupMember[]
  sharedExpenses      SharedExpense[]
  sharedExpenseShares SharedExpenseShare[]
  splitSettlements    SplitSettlement[]
  splitInvites        SplitInvite[]
  splitMirrors        SplitMirror[]
  splitContributions  SplitContribution[]
  savingsPlans SavingsPlan[]
  savingsInstallments SavingsInstallment[]
  policies     InsurancePolicy[]
  premiums     PremiumPayment[]
  accounts     Account[]
  categories   Category[]
  people       Person[]
  transactions Transaction[]
  entries      LedgerEntry[]

  @@index([ownerUserId])
  @@index([status])
  @@index([planId])
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

/// Proof that an erasure was carried out, holding nothing about who it was.
///
/// Everything the person owned is gone by the time a row lands here — the
/// cascade takes the workspace, the ledger and their own `User` row with it,
/// audit trail included. That is what erasure means and it is what the store
/// policies and the data-protection rules require.
///
/// But a company that cannot say *whether* it processed a request has no answer
/// when somebody asks a second time, or when a regulator does. So one row
/// survives, carrying a SHA-256 of the address and two timestamps: enough to
/// answer "was this dealt with, and when", and not enough to tell anybody whose
/// account it was. The hash is one-way; an address can be checked against it
/// only by somebody who already knows the address.
/// Bringing another product's books across, one reviewable batch at a time.
///
/// ## Why a staging table and not a straight import
///
/// The owner's Wallet account holds twenty accounts and two hundred categories,
/// and most of those categories are not categories at all — a DPS became one
/// because Wallet had nowhere else to put it. Creating all two hundred and
/// sorting it out afterwards would take a usable chart of accounts and make it
/// unusable, so nothing is created until every row has been decided.
///
/// Staging also makes the decisions survive a closed browser, and makes the
/// whole thing exportable to a spreadsheet: two hundred choices are faster in
/// Excel than in a web form, and the person already knows which of these are
/// savings plans.
///
/// ## Why the batch exists separately
///
/// So it can be undone. `rolledBackAt` and the `createdEntityId` on each item
/// are the whole of it: apply writes ids down, rollback deletes exactly those
/// and nothing else. An import somebody cannot take back is an import they will
/// not risk running.
model MigrationBatch {
  id          String   @id @default(cuid())
  workspaceId String
  /// `WALLET` today. The staging shape is deliberately source-agnostic.
  source      String
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  appliedAt   DateTime?
  rolledBackAt DateTime?
  createdByUserId String?
  /// What the pull found, so the screen can show progress without counting rows.
  note        String?

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items     MigrationItem[]

  @@index([workspaceId, createdAt])
}

/// One account or one category from the other product, and what to do with it.
model MigrationItem {
  id          String @id @default(cuid())
  batchId     String
  workspaceId String
  /// `ACCOUNT` or `CATEGORY`.
  kind        String
  /// The id it had over there. What makes a second run skip rather than double.
  sourceId    String
  sourceName  String
  /// The name to create it with, when it should not be the one it arrived
  /// with. Kept beside `sourceName` rather than overwriting it: the source name
  /// is what a second pull matches on and what a person recognises from the
  /// other product, and losing it would make the row unidentifiable.
  targetName  String?
  /// Everything else the source said, kept verbatim so a decision made later
  /// has the same information the pull had.
  sourcePayload Json?
  /// How many records used it, so the list can put the ones that matter first.
  usageCount  Int    @default(0)

  /// `CREATE` | `MERGE` | `SAVINGS` | `INSURANCE` | `SKIP`.
  decision    String @default("CREATE")
  /// For an account: which `AccountType`. Guessed from the source, overridable.
  targetType  String?
  /// For `MERGE`: the existing row to fold this into. For a category being
  /// created: the existing category it sits under.
  targetId    String?
  /// …or the `sourceId` of another row in this same batch, when the parent is
  /// itself being created here. The other product's groups are its categories'
  /// parents, and none of the thirteen exists in this workspace yet — so the
  /// parent is staged alongside the children and created just before them.
  ///
  /// A source id rather than a row id because both are written in one
  /// `createMany`, which cannot know the ids it is about to generate.
  parentSourceId String?
  /// What the source could not tell us and the entity cannot do without: a
  /// credit card's statement and due days, a DPS's instalment, term and rate, a
  /// policy's premium. Filled in on the draft rather than after applying,
  /// because a savings plan created with an invented twelve-month term is a
  /// wrong number nobody can tell was invented.
  targetDetail Json?

  /// Set by apply, read by rollback. The two halves of being able to undo.
  createdEntityId   String?
  createdEntityKind String?
  /// Why this row did nothing, when it did nothing.
  skippedReason     String?

  batch MigrationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, kind, sourceId])
  @@index([workspaceId, kind])
}

model AccountDeletion {
  id          String   @id @default(cuid())
  /// SHA-256 of the lower-cased email. Never the address itself.
  emailHash   String   @unique
  requestedAt DateTime
  completedAt DateTime @default(now())
  /// Free text the person left, if any. Trimmed to 500 characters, and their
  /// own words — so it may name nobody but themselves.
  reason      String?

  @@index([completedAt])
}

model Membership {
  id          String           @id @default(cuid())
  workspaceId String
  userId      String
  role        MembershipRole   @default(OWNER)
  invitedBy   String?
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, status])
}

model Invitation {
  id          String         @id @default(cuid())
  workspaceId String
  email       String
  role        MembershipRole @default(MEMBER)
  tokenHash   String         @unique
  invitedBy   String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sender    User?     @relation("InvitationSender", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@index([workspaceId, email])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Accounts & categories
// ---------------------------------------------------------------------------

enum AccountType {
  CASH
  BANK
  MOBILE_WALLET
  CREDIT_CARD
  SAVINGS
  RECEIVABLE
  PAYABLE
  ASSET
  LIABILITY
  EQUITY
}

/// There is deliberately no `openingBalance` column here.
///
/// There was one until 20260816230000_opening_balance_to_ledger. It was added
/// straight into every balance and posted no ledger entry, so a figure inside
/// every total was invisible to the transaction list, the account statement and
/// the audit trail — and it carried no date, so a balance sheet dated last
/// January showed the opening balance of an account opened in June. Two periods
/// were therefore not comparable, which is what IAS 1.38 is about.
///
/// An opening balance is now an `OPENING_BALANCE` transaction against the
/// workspace's SYSTEM_EQUITY account, dated the day the person says it was
/// true. `AccountsService` still accepts and returns `openingBalance` on the
/// API, derived from that transaction; nothing reads a column, because there is
/// no column left to read.
model Account {
  id                  String      @id @default(cuid())
  workspaceId         String
  name                String
  type                AccountType
  currency            String      @default("BDT")
  institution         String?
  accountNumberMasked String?
  matchHints          String[]    @default([])
  /// Whatever has to be remembered about this account and belongs nowhere else:
  /// the branch, the nominee, the cheque-book series, who else can sign on it.
  ///
  /// Free text on purpose. Every attempt to give these their own columns ends
  /// with a form nobody fills in, and the one fact that actually mattered was
  /// never one of the columns anyway.
  note                String?
  /// What kind of thing this is, for `type = ASSET` only.
  ///
  /// Land, a car and a BO share account are all `ASSET` and are three different
  /// things on a balance sheet: IAS 1.54 puts property, plant and equipment on
  /// one line and financial investments on another. Without this they were one
  /// undifferentiated pile and no screen could separate them.
  assetKind           AssetKind?
  /// What it cost, in poisha, and when. Nullable because most accounts are not
  /// assets and because somebody may not remember.
  ///
  /// Kept alongside the ledger balance rather than replacing it. The balance is
  /// the carrying amount — cost plus every revaluation since — and this is the
  /// original. IAS 16.77(e) asks for exactly that comparison under the
  /// revaluation model: what the carrying amount would have been at cost.
  purchaseCostMinor   BigInt?
  purchaseDate        DateTime?
  isArchived          Boolean     @default(false)
  sortOrder           Int         @default(0)
  icon                String?
  color               String?
  /// Set on the nominal accounts that make the double entry balance
  /// (SYSTEM_INCOME / SYSTEM_EXPENSE / SYSTEM_EQUITY) and on the two loan
  /// control accounts (SYSTEM_LOAN_RECEIVABLE / SYSTEM_LOAN_PAYABLE). All five
  /// are kept off the wallet list and out of the plan's account limit. The
  /// balance sheet does *not* filter on this: it sorts by account class, so the
  /// loan control accounts appear there and the nominal ones do not.
  systemKey           String?
  /// Credit cards only. What the bank will let this card carry, in poisha.
  ///
  /// Never an asset. IAS 7.6 keeps cash to what is held — cash in hand and
  /// demand deposits — and an undrawn limit is neither: the money sits with the
  /// bank, which may reduce or withdraw the facility, so there is nothing the
  /// Conceptual Framework would call a controlled resource and no past event to
  /// recognise. IAS 7.50(a) has it exactly right: undrawn facilities are
  /// *disclosed*, not recognised. It is held here so the app can say what could
  /// be spent, beside — never inside — what is owned.
  creditLimitMinor    BigInt @default(0)
  /// Credit cards only. 1–31; a due day past the end of a short month is
  /// clamped to its last day, so the 31st is the 28th in February.
  statementDayOfMonth Int?
  dueDayOfMonth       Int?
  /// null falls back to the workspace default.
  reminderLeadDays    Int?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  deletedAt           DateTime?

  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries        LedgerEntry[]
  splitSettlements SplitSettlement[]
  splitPots        SplitGroup[]        @relation("SplitGroupPot")
  splitContributions SplitContribution[]
  reminderCycles CardReminderCycle[]
  obligations    AssetObligation[]
  loansFunded    Loan[]              @relation("LoanCashAccount")
  /// Many, not one: every LENT loan in the workspace posts to the same
  /// SYSTEM_LOAN_RECEIVABLE account and every BORROWED one to the same
  /// SYSTEM_LOAN_PAYABLE.
  loanControlFor Loan[]              @relation("LoanControlAccount")
  loanPayments   LoanPayment[]

  @@unique([workspaceId, systemKey])
  @@index([workspaceId, isArchived, sortOrder])
}

enum CategoryKind {
  INCOME
  EXPENSE
}

model Category {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  nameBn      String?
  /**
   * Extra words that should find this category.
   *
   * Transliteration gets `khabar` to খাবার because they are the same word in two
   * scripts. It cannot get `restaurant` to খাবার ও বাজার, or `poribohon` to
   * যাতায়াত — those are synonyms, and no amount of letter mapping bridges them.
   * Proven live: `poribohon` returned nothing while `khabar` and `bajar` both
   * ranked first.
   */
  searchAliases String[]   @default([])
  parentId    String?
  kind        CategoryKind
  icon        String?
  color       String?
  isSystem    Boolean      @default(false)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[]    @relation("CategoryTree")
  entries   LedgerEntry[]
  sharedExpenses SharedExpense[]

  @@index([workspaceId, kind, sortOrder])
}

model Person {
  id          String    @id @default(cuid())
  workspaceId String
  /**
   * The handle you can say out loud: P-0001, P-0002.
   *
   * A number identifies most people and a name identifies none of them, but
   * some people have neither — two suppliers called "রফিক এন্টারপ্রাইজ" on the
   * same shop phone are two accounts, and somebody has to be able to point at
   * one of them on a delivery note. `id` is a cuid nobody will ever read aloud;
   * this is short, ordered, and printable on a statement.
   *
   * Unique per workspace, never reused, never renumbered — a code somebody has
   * already written in a paper ledger must not come to mean somebody else.
   */
  code        String
  /**
   * The number inside `code`, so "what is the next one" is arithmetic.
   *
   * `code` sorts as text, and text puts P-9999 above P-10000 — so reading the
   * highest code off a string sort handed out P-10000 twice once a workspace
   * passed ten thousand people, and the second one bounced off the unique
   * index. The integer is the sort key; the string is what gets printed.
   */
  codeSeq     Int
  name        String
  phone       String?
  /**
   * The phone reduced to one spelling, for deciding whether two rows are the
   * same person.
   *
   * `phone` keeps whatever was typed — "01712-345678", "+8801712345678", a
   * landline — because that is the best record of how to reach somebody.
   * `phoneKey` is `01712345678` and nothing else, and it is what the unique
   * index is on. Two names are not evidence of two people; a number is.
   */
  phoneKey    String?
  /** Lower-cased and trimmed. The other thing that identifies somebody. */
  email       String?
  relation    String?
  note        String?
  photoUri    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  loans        Loan[]
  splitMembers SplitGroupMember[]

  @@index([workspaceId])
  /* One person per number, per workspace. Partial, because most people in a
     household ledger have no number at all and many nulls must not collide. */
  @@unique([workspaceId, code])
  @@unique([workspaceId, codeSeq])
  @@unique([workspaceId, phoneKey])
  @@unique([workspaceId, email])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

enum AuditActorType {
  USER
  SYSTEM
  SUPPORT
  INTEGRATION
}

/// Append-only. Nothing in the application updates or deletes a row here, and
/// no query ever crosses a workspace boundary (v3 §A3). Bodies of inbound
/// messages are never recorded — only that something happened, to what.
model AuditEvent {
  id           String         @id @default(cuid())
  workspaceId  String
  actorUserId  String?
  actorType    AuditActorType @default(USER)
  action       String
  entity       String?
  entityId     String?
  before       Json?
  after        Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, action])
  @@index([workspaceId, entity, entityId])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum TelegramMode {
  /// The official Hishab bot. We store a chat id, which is an address, not a
  /// secret — no per-user credential to guard.
  SHARED_BOT
  /// The member brought their own bot. Its token is a credential and is
  /// handled exactly like an IMAP password (v3 §C6).
  OWN_BOT
}

enum TelegramStatus {
  PENDING
  ACTIVE
  AUTH_FAILED
  DISABLED
  REVOKED
}

model TelegramConnection {
  id          String         @id @default(cuid())
  workspaceId String
  userId      String
  mode        TelegramMode   @default(SHARED_BOT)
  /// Null until the binding handshake completes.
  chatId      String?
  /// Only ever set in OWN_BOT mode. Points at the secret store; the token
  /// itself is never in this table and never in an API response.
  botTokenRef String?
  botUsername String?
  /// Single-use, hashed, short-lived. Matched when Telegram delivers /start.
  bindingTokenHash String?
  bindingExpiresAt DateTime?
  isEnabled   Boolean        @default(false)
  verifiedAt  DateTime?
  status      TelegramStatus @default(PENDING)
  failureCount Int           @default(0)
  lastError   String?
  lastSentAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  revokedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@unique([bindingTokenHash])
  @@index([status])
}

enum CardMuteReason {
  MANUAL
  PAID
}

/// One row per card per billing cycle. Muting writes to the current row, so the
/// next month is a fresh row and reminders resume with no un-mute job.
model CardReminderCycle {
  id            String          @id @default(cuid())
  workspaceId   String
  accountId     String
  /// `YYYY-MM`
  cycleMonth    String
  dueDate       DateTime
  windowStart   DateTime
  windowEnd     DateTime
  mutedAt       DateTime?
  mutedByUserId String?
  mutedReason   CardMuteReason?
  /// `YYYY-MM-DD` in the workspace timezone. The idempotency guard: a worker
  /// restart must never send twice in one day.
  lastSentOn    String?
  sentCount     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, cycleMonth])
  @@index([workspaceId, cycleMonth])
}

// ---------------------------------------------------------------------------
// People & lending
// ---------------------------------------------------------------------------

enum LoanDirection {
  LENT
  BORROWED
}

enum LoanInterestType {
  NONE
  FIXED
  PERCENT
}

enum LoanStatus {
  ACTIVE
  COMPLETED
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK
  MOBILE_WALLET
  CHEQUE
  CARD
  OTHER
}

/// A loan given or taken.
///
/// The money itself lives in the ordinary double-entry ledger, exactly as it
/// would in QuickBooks: the workspace has *two* control accounts, ঋণ পাওনা
/// (RECEIVABLE) and ঋণ দেনা (PAYABLE), and disbursement and repayment are plain
/// transfers between the matching one and a cash or bank account. So the
/// balance sheet, the cash flow statement and the running balance on the
/// account statement all pick loans up with no special-casing, and no loan
/// movement is ever counted as income or expense.
///
/// Two control accounts, not two hundred. What each person owes is the
/// subsidiary ledger, and it is *derived*: `GET /loans/:id` and
/// `GET /loans/people/:personId/ledger` compute it from these rows and their
/// payments, so a per-loan balance can never disagree with the account it rolls
/// up into.
///
/// This table therefore holds only what the ledger cannot: the loan number, the
/// counterparty, the agreed terms and the due date.
model Loan {
  id          String @id @default(cuid())
  workspaceId String
  /// Human-facing, unique per workspace: L-0001, L-0002, …
  loanNumber  String
  personId    String
  direction   LoanDirection

  principalMinor BigInt
  /// Off by default: most household lending in Bangladesh carries no interest.
  interestType   LoanInterestType @default(NONE)
  /// A single agreed sum when interestType is FIXED, poisha.
  interestMinor  BigInt           @default(0)
  /// Annual rate in basis points when interestType is PERCENT: 8.25% is 825.
  interestRateBps Int             @default(0)

  loanDate DateTime
  dueDate  DateTime?

  /// The cash or bank account the principal moved through.
  accountId     String
  /// The workspace's shared RECEIVABLE (LENT) or PAYABLE (BORROWED) control
  /// account that this loan's entries post to. Kept rather than re-derived from
  /// `direction` on every read because it records where the money *actually*
  /// went: it is the join the migration verified and the one that stays true if
  /// a workspace ever gains a third control account. Not unique — the whole
  /// point is that every loan of a direction shares one.
  loanAccountId String
  /// The disbursement transaction, so the two can never drift apart.
  transactionId String?

  note          String?
  attachmentIds String[]   @default([])
  status        LoanStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  person      Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  account     Account       @relation("LoanCashAccount", fields: [accountId], references: [id], onDelete: Restrict)
  loanAccount Account       @relation("LoanControlAccount", fields: [loanAccountId], references: [id], onDelete: Restrict)
  payments    LoanPayment[]
  accruals    LoanInterestAccrual[]

  @@unique([workspaceId, loanNumber])
  @@index([workspaceId, loanAccountId])
  @@index([workspaceId, status])
  @@index([workspaceId, direction, status])
  @@index([workspaceId, personId])
  @@index([workspaceId, dueDate])
}

/// One instalment against a loan. Immutable once written: a correction is a new
/// row, never an edit, so the payment history stays an audit trail.
model LoanPayment {
  id          String @id @default(cuid())
  workspaceId String
  loanId      String

  date            DateTime
  amountMinor     BigInt
  method          PaymentMethod @default(CASH)
  referenceNumber String?
  note            String?
  attachmentIds   String[]      @default([])

  /// The cash or bank account the instalment moved through.
  accountId     String
  /// The transfer this payment booked.
  transactionId String?

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  loan      Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([workspaceId, loanId, date])
  @@index([workspaceId, referenceNumber])
}

/// One period of loan interest, recognised in the ledger instead of only being
/// derived for display.
///
/// Only ever written for a loan whose `interestType` is not NONE. Interest-free
/// family lending — most of what this product records — has nothing to accrue,
/// and this table stays empty for it.
///
/// `throughDate` is the local calendar day the period runs to, `YYYY-MM-DD`,
/// stored as text for the same reason `AssetObligation.lastRemindedOn` is: a
/// timestamp would need a timezone to be compared and would let a restart, an
/// overlapping sweep or a second instance post the same month twice. The unique
/// index on it is the hard guarantee behind the arithmetic — the amount posted
/// is always "what the terms say less what the books already hold", so a repeat
/// run computes zero, and the index makes that true even for two sweeps racing.
model LoanInterestAccrual {
  id          String @id @default(cuid())
  workspaceId String
  loanId      String

  /// Local calendar day this accrual runs to, YYYY-MM-DD.
  throughDate String
  /// Poisha recognised for this period. Zero is a real answer: the period was
  /// considered and earned nothing, and the row is what stops it being
  /// reconsidered every hour for the rest of the loan's life.
  amountMinor BigInt @default(0)
  /// The posting. Null when the period was worth nothing — a zero-value
  /// transaction would be noise on every statement it appeared in.
  transactionId String?

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  loan      Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, throughDate])
  @@index([workspaceId, loanId])
}

// ---------------------------------------------------------------------------
// Savings & insurance
// ---------------------------------------------------------------------------

/// The kinds of long-term asset a household actually holds.
///
/// Deliberately short. A longer list is a longer form, and every extra option
/// is one more chance to file the same flat under two different headings in two
/// different years — which destroys the comparability the split exists for.
enum AssetKind {
  /// Land, flats, shops. IAS 16 property.
  PROPERTY
  /// Cars, motorcycles, machinery. IAS 16 plant and equipment.
  VEHICLE
  /// Gold, jewellery, anything held for its metal.
  GOLD
  /// Shares, bonds, a BO account. IFRS 9 rather than IAS 16.
  INVESTMENT
  OTHER
}

enum SavingsPlanType {
  DPS
  FDR
  SANCHAYPATRA
  RECURRING_DEPOSIT
  GOAL_SAVINGS
}

enum ProfitCalc {
  SIMPLE
  COMPOUND_MONTHLY
  COMPOUND_QUARTERLY
  COMPOUND_YEARLY
}

enum PlanFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum SavingsStatus {
  ACTIVE
  MATURED
  CLOSED
}

enum InstalmentStatus {
  DUE
  PAID
  MISSED
  SKIPPED
}

model SavingsPlan {
  id              String          @id @default(cuid())
  workspaceId     String
  institution     String?
  planName        String
  planType        SavingsPlanType @default(DPS)
  /// One instalment, in poisha. Zero for a lump-sum FDR.
  installmentMinor BigInt         @default(0)
  /// The lump sum an FDR or Sanchayapatra starts with.
  principalMinor  BigInt          @default(0)
  frequency       PlanFrequency   @default(MONTHLY)
  termMonths      Int
  startDate       DateTime
  maturityDate    DateTime?
  /// Annual rate in basis points, so 8.25% is 825 — the user types the rate
  /// their bank advertises and we never infer it.
  profitRateBps   Int             @default(0)
  profitCalc      ProfitCalc      @default(COMPOUND_YEARLY)
  linkedAccountId String?
  status          SavingsStatus   @default(ACTIVE)
  note            String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installments SavingsInstallment[]
  transactions Transaction[]

  @@index([workspaceId, status])
}

model SavingsInstallment {
  id            String           @id @default(cuid())
  workspaceId   String
  planId        String
  dueDate       DateTime
  expectedMinor BigInt
  paidDate      DateTime?
  transactionId String?
  status        InstalmentStatus @default(DUE)

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      SavingsPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, dueDate])
  @@index([workspaceId, status, dueDate])
}

enum PolicyStatus {
  ACTIVE
  LAPSED
  MATURED
  CANCELLED
}

model InsurancePolicy {
  id                  String        @id @default(cuid())
  workspaceId         String
  insurer             String
  policyNumberMasked  String?
  policyType          String?
  sumAssuredMinor     BigInt        @default(0)
  premiumMinor        BigInt        @default(0)
  frequency           PlanFrequency @default(YEARLY)
  startDate           DateTime
  maturityDate        DateTime?
  nomineeName         String?
  status              PolicyStatus  @default(ACTIVE)
  note                String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  premiums  PremiumPayment[]

  @@index([workspaceId, status])
}

model PremiumPayment {
  id            String           @id @default(cuid())
  workspaceId   String
  policyId      String
  dueDate       DateTime
  amountMinor   BigInt
  paidDate      DateTime?
  transactionId String?
  status        InstalmentStatus @default(DUE)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  policy    InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, dueDate])
  @@index([workspaceId, status, dueDate])
}

// ---------------------------------------------------------------------------
// Ledger
// ---------------------------------------------------------------------------

/// A photo of a receipt, or any file a user attached to a record.
///
/// The bytes live on the server's own disk under a content-addressed path, not
/// in the database and not in object storage: the user chose local disk, and a
/// BYTEA column would drag every receipt through the same buffer as the ledger.
/// The row exists so a file can be found, checked and deleted by id, and so a
/// workspace's attachments can never be read across the tenant boundary.
model Attachment {
  id              String  @id @default(cuid())
  workspaceId     String
  createdByUserId String?

  /// What the user called it. Shown back to them; never used as a path.
  filename    String
  mimeType    String
  sizeBytes   Int
  /// SHA-256 of the bytes. Two uploads of the same receipt share one file on
  /// disk, and a corrupted read can be detected rather than served.
  sha256      String
  /// Path relative to the attachment root, derived from the hash. Never from
  /// anything the user typed.
  storagePath String

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, sha256])
}

enum ImportStatus {
  PENDING
  APPLIED
  REVERTED
}

/// One spreadsheet upload.
///
/// Imports are recorded as a batch so the whole thing can be undone in one
/// action. Somebody who maps a column wrong and lands two hundred rows in the
/// wrong account needs one button, not two hundred deletions.
model ImportBatch {
  id          String       @id @default(cuid())
  workspaceId String
  createdByUserId String?
  filename    String
  /// SHA-256 of the uploaded bytes, so the same file offered twice can be
  /// spotted before it doubles somebody's books.
  fileHash    String
  /// The column mapping the user chose, kept so the next import of the same
  /// export can reuse it.
  mapping     Json
  rowCount    Int          @default(0)
  importedCount Int        @default(0)
  skippedCount  Int        @default(0)
  status      ImportStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  appliedAt   DateTime?
  revertedAt  DateTime?

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, fileHash])
}

enum MailProvider {
  /// Username and app password. Closing: Microsoft 365 has already disabled
  /// basic auth, and Google keeps narrowing app passwords.
  IMAP
  GMAIL_OAUTH
  OUTLOOK_OAUTH
}

enum MailAccountStatus {
  ACTIVE
  /// Credentials rejected. Kept rather than deleted so the user is told why.
  AUTH_FAILED
  DISABLED
}

/**
 * One mailbox a tenant has connected.
 *
 * Credentials are encrypted with a key held outside the database backup, so a
 * stolen dump does not hand over somebody's mailbox. Reading a mailbox is slow
 * and rate-limited, so nothing here is fetched inside an HTTP request — a sync
 * worker does it and the screens read what it stored.
 */
model MailAccount {
  id          String            @id @default(cuid())
  workspaceId String
  provider    MailProvider
  /// The address, shown to the user. Never a credential.
  email       String
  /// Encrypted. IMAP host/port/password, or an OAuth refresh token.
  secretCipher String
  secretIv     String
  imapHost    String?
  imapPort    Int?
  status      MailAccountStatus @default(ACTIVE)
  lastError   String?
  lastSyncAt  DateTime?
  /// Only messages after this are read, so connecting a decade-old mailbox does
  /// not pull ten years of mail on the first sync.
  syncSince   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  MailMessage[]

  @@unique([workspaceId, email])
  @@index([workspaceId, status])
}

enum MailFolder {
  INBOX
  SENT
  DRAFTS
  ARCHIVE
}

/// A message pulled from a connected mailbox. Tenant-scoped like everything
/// else; one workspace can never read another's mail.
model MailMessage {
  id            String     @id @default(cuid())
  workspaceId   String
  mailAccountId String
  folder        MailFolder
  /// The provider's own id, so a re-sync updates rather than duplicates.
  externalId    String
  fromAddress   String?
  toAddress     String?
  subject       String?
  snippet       String?
  body          String?
  receivedAt    DateTime
  isRead        Boolean    @default(false)
  createdAt     DateTime   @default(now())

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mailAccount MailAccount @relation(fields: [mailAccountId], references: [id], onDelete: Cascade)

  @@unique([mailAccountId, folder, externalId])
  @@index([workspaceId, folder, receivedAt(sort: Desc)])
}

/**
 * A tenant's own SMS gateway, for **sending**.
 *
 * Receiving is not here and cannot be: no server can read a phone's SMS on
 * either platform. Inbound stays device-side — a forwarder app on Android, a
 * Shortcuts automation on iOS.
 */
model SmsGateway {
  id           String   @id @default(cuid())
  workspaceId  String
  /// 'twilio', 'ssl-wireless', 'bulksmsbd' — a string, so adding one is data.
  provider     String
  senderId     String?
  secretCipher String
  secretIv     String
  isActive     Boolean  @default(true)
  lastError    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isActive])
}

enum IngestionChannel {
  SMS
  EMAIL
  WEBHOOK
}

enum DraftStatus {
  PENDING
  ACCEPTED
  REJECTED
  DUPLICATE
}

/// A message that arrived from outside — a bank SMS, an email alert, a webhook.
///
/// The raw body is kept because a parser that gets something wrong can only be
/// fixed against the text that broke it. It is also the deduplication key: the
/// same alert delivered twice must produce one draft, not two.
model IngestionMessage {
  id          String           @id @default(cuid())
  workspaceId String
  channel     IngestionChannel
  /// Sender address, shortcode or webhook source.
  sender      String?
  receivedAt  DateTime
  body        String
  /// SHA-256 of channel + sender + body, unique per workspace.
  bodyHash    String
  /// Whatever the parser produced, kept for debugging a bad parse.
  parsed      Json?
  parserName  String?
  createdAt   DateTime         @default(now())

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  drafts    TransactionDraft[]

  @@unique([workspaceId, bodyHash])
  @@index([workspaceId, receivedAt(sort: Desc)])
}

/// A proposed transaction awaiting a human.
///
/// Nothing an SMS parser produces reaches the ledger on its own. The draft
/// carries a confidence score and the exact span of text each field came from,
/// so the review screen can show its working rather than asking for blind trust.
model TransactionDraft {
  id          String      @id @default(cuid())
  workspaceId String
  messageId   String?
  status      DraftStatus @default(PENDING)

  date        DateTime?
  amountMinor BigInt?
  direction   String?
  payee       String?
  accountId   String?
  categoryId  String?
  /// 0–100. Below the review threshold the draft is shown but never applied.
  confidence  Int         @default(0)
  /// Field name to the substring it was read from, for the "why" popover.
  evidence    Json?
  /// Which model proposed the category and account, when one did.
  ///
  /// A regular expression can find an amount; it can never know that "স্বপ্ন"
  /// is groceries. A model can, and the review screen says so — the person
  /// deciding should be told which of the fields in front of them were read
  /// from their bank and which were guessed by a machine that has never seen
  /// their books.
  suggestedBy String?

  /// Set once accepted, so a draft can never be applied twice.
  transactionId String?  @unique
  reviewedAt    DateTime?
  reviewedByUserId String?
  createdAt     DateTime @default(now())

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  message   IngestionMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, createdAt(sort: Desc)])
}

/**
 * A label a user puts on a transaction, orthogonal to its category.
 *
 * The category answers *what* the money went on — খাবার ও বাজার. A tag answers
 * *who for* or *what project* — পারিবারিক, শ্বশুরবাড়ি, রমজান, গাড়ি. The same
 * grocery bill can be a family expense one week and a business one the next,
 * and forcing that into the category would corrupt every spending report to
 * record something the category was never about.
 *
 * A transaction has exactly one category and as many tags as it needs, which is
 * the whole reason this is a separate table rather than another column.
 */
model Tag {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  /// Optional Bengali name, so a tag typed in English still reads well.
  nameBn      String?
  /// Extra words that should find this tag — the same reasoning as categories:
  /// transliteration reaches `poribar` from পরিবার, but never `family`.
  searchAliases String[] @default([])
  color       String?
  icon        String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]

  @@unique([workspaceId, name])
  @@index([workspaceId, sortOrder])
}

/**
 * The join between a transaction and its tags.
 *
 * An explicit table rather than an implicit many-to-many so it can carry
 * `workspaceId` — every other join in this schema is guarded that way, and a
 * tag row that could point across tenants would be the one place the boundary
 * did not hold.
 */
model TransactionTag {
  transactionId String
  tagId         String
  workspaceId   String
  createdAt     DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@index([workspaceId, tagId])
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  LOAN_GIVEN
  LOAN_REPAID
  BORROWED
  BORROW_REPAID
  SAVINGS_DEPOSIT
  SAVINGS_WITHDRAWAL
  PREMIUM_PAID
  ADJUSTMENT
  /// Marking an asset to what it is worth now — land, gold, a vehicle.
  /// Distinct from ADJUSTMENT so a revaluation can be told apart from a cash
  /// reconciliation on the statement of changes in net worth, which is the one
  /// place a reader goes to ask why net worth moved without any income.
  REVALUATION
  /// Selling the asset: land, a car, gold, shares.
  ///
  /// Its own type because it is the opposite of REVALUATION in the one way that
  /// matters. Revaluing moves net worth without any money changing hands and
  /// posts to equity (IAS 16.39); selling turns the asset into cash and the
  /// gain or loss goes to profit or loss (IAS 16.68). Mixing the two would put
  /// a realised gain in equity or an unrealised one in income, and both are
  /// wrong in the direction that flatters.
  DISPOSAL
  OPENING_BALANCE
}

enum TransactionSource {
  MANUAL
  SMS
  EMAIL
  WEBHOOK
  OCR
  IMPORT
  RECURRING
}

/// A transaction whose money was originally in another currency records both:
/// `amountMinor` in the workspace's currency (what the books are kept in) and
/// `fxAmountMinor` in `fxCurrency` (what was actually spent). The rate is the
/// ratio, so nothing float-shaped is ever stored.
model Transaction {
  id            String            @id @default(cuid())
  workspaceId   String
  /// Who entered it. Matters once a workspace has more than one member.
  createdByUserId String?
  date          DateTime
  type          TransactionType
  description   String?
  notes         String?
  payee         String?
  /// How much of a thing was bought, in thousandths of `quantityUnit`. Half a
  /// kilo is 500. An integer for the same reason money is one — see the
  /// migration.
  quantityMilli BigInt?
  /// Free text: কেজি, লিটার, পিস, ডজন. An enum would be wrong within a week.
  quantityUnit  String?
  /// ISO 4217 of the money as it was actually spent. Null = the workspace's own.
  fxCurrency    String?
  /// The amount in `fxCurrency`, integer minor units of *that* currency.
  fxAmountMinor BigInt?
  personId      String?
  /// Which savings instrument this row belongs to, when it belongs to one.
  ///
  /// The point is profit. A Sanchayapatra pays out monthly or quarterly and the
  /// money lands in an ordinary bank account, so without this the ledger knows
  /// a profit arrived and not which certificate produced it — and "how much did
  /// this DPS earn me this year" cannot be answered at all. `personId` above
  /// solves the same problem for people and is deliberately mirrored here,
  /// `SetNull` included: deleting a plan must not take its income with it.
  savingsPlanId String?
  attachmentIds String[]          @default([])
  source        TransactionSource @default(MANUAL)
  sourceDraftId String?
  importBatchId String?
  externalRef   String?
  /// Device-generated UUID so offline rows keep identity across sync (§8).
  clientId      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User?         @relation("TransactionAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)
  person      Person?      @relation(fields: [personId], references: [id], onDelete: SetNull)
  savingsPlan SavingsPlan? @relation(fields: [savingsPlanId], references: [id], onDelete: SetNull)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  entries     LedgerEntry[]
  tags        TransactionTag[]
  sharedExpenses   SharedExpense[]
  splitSettlements SplitSettlement[]
  splitContributions SplitContribution[]

  @@unique([workspaceId, clientId])
  @@index([workspaceId, date(sort: Desc)])
  @@index([workspaceId, type])
  @@index([workspaceId, source])
  @@index([workspaceId, externalRef])
  @@index([workspaceId, importBatchId])
  @@index([workspaceId, savingsPlanId])
}

enum EntryDirection {
  DEBIT
  CREDIT
}

/// A workspace's own corrections to the interface's wording. See the migration.
model WorkspaceTranslation {
  id              String   @id @default(cuid())
  workspaceId     String
  /// 'bn' or 'en' — a correction is per language.
  locale          String
  key             String
  value           String
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, locale, key])
  @@index([workspaceId, locale])
}

model LedgerEntry {
  id            String         @id @default(cuid())
  /// Denormalised from the transaction so balance aggregation does not need a
  /// join. A database trigger keeps the two in step — see the migration.
  workspaceId   String
  transactionId String
  accountId     String
  categoryId    String?
  /// Always positive; `direction` carries the sign.
  amountMinor   BigInt
  direction     EntryDirection
  currency      String         @default("BDT")
  /// Always 1. A placeholder, and not a usable exchange rate — read this before
  /// trusting it.
  ///
  /// The old comment here said "kept so multi-currency is a data change, not a
  /// migration". That is not true of an `Int`: a rate is 121.50, and the column
  /// cannot hold it. `ledgerEntrySchema` even validates `fxRate` as
  /// `z.number().positive()`, so a real rate passes the zod check and is then
  /// rejected or truncated at the database. Every writer in the codebase passes
  /// 1 — `packages/core/src/ledger.ts`, `split.service.ts`, `loans.service.ts` —
  /// and `baseMinor` short-circuits on `fxRate === 1`, so nothing has ever
  /// exercised the other branch.
  ///
  /// It is deliberately left as-is rather than widened. Widening buys nothing
  /// today: conversion is not implemented anywhere, so a `Decimal` here would be
  /// an empty box that *looks* like the feature exists — the same mistake this
  /// comment is correcting. The real work is a per-date spot rate on the
  /// transaction (IAS 21.21) and a closing rate to retranslate monetary balances
  /// by (IAS 21.23(a)), with the difference that falls out recognised in profit
  /// or loss (IAS 21.28): a schema for rates and a place to book the exchange
  /// difference, not one wider column.
  ///
  /// Until that exists the app does not convert. Accounts kept in another
  /// currency are excluded from every taka total — see
  /// `AccountsService.position` — and the receipt of money originally spent in
  /// another currency lives on `Transaction.fxCurrency` / `fxAmountMinor`,
  /// converted by the user at entry time.
  fxRate        Int            @default(1)

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  // Cascade so deleting a workspace removes its whole ledger. Account deletion
  // is never offered in the UI (accounts are archived); this exists so the
  // "delete my account and all my data" store requirement actually works.
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([workspaceId, accountId])
  @@index([workspaceId, categoryId])
}

// ---------------------------------------------------------------------------
// Shared and pooled spending
// ---------------------------------------------------------------------------

/// How a shared expense divides between the people on it.
enum SplitMethod {
  /// Everybody the same. The remainder poisha go to the earliest members.
  EQUAL
  /// A stated amount each; the parts must add up to the total.
  EXACT
  /// Basis points each; must total 10,000.
  PERCENT
  /// Weights — "Karim eats double" is 2 against 1.
  SHARES
}

enum SplitGroupPurpose {
  TRIP
  HOUSEHOLD
  OFFICE
  EVENT
  OTHER
}

/// A set of people who spend together: a trip, a flat, an office lunch.
///
/// The group is a *record-keeping* device, not an accounting entity. Nothing is
/// posted to a group; every entry lands in the owner's own ledger, and what the
/// group adds is who was on it and how it divided. That is why a member can be
/// somebody with no account here — your flatmate does not need to install an
/// app for you to keep an honest record of what they owe you.
model SplitGroup {
  id          String            @id @default(cuid())
  workspaceId String
  name        String
  purpose     SplitGroupPurpose @default(OTHER)
  /// The group's own currency. Members may settle in another; conversion
  /// happens where every other conversion in this product happens, on the entry.
  currency    String            @default("BDT")
  note        String?

  /**
   * The account holding a common pot, when this group has one.
   *
   * A family fund, an office samity, a trip kitty. Set means members pay *in*
   * and spending comes *out*; null means the ordinary case where one person
   * picks up a bill and the others owe them.
   *
   * A real `ASSET` account rather than a number on the group: the money exists,
   * somebody is holding it, and it belongs on their balance sheet. What each
   * member put in is a payable to that member, which is what makes the pot
   * theirs rather than the holder's.
   */
  potAccountId String?

  createdByUserId String?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User?              @relation("SplitGroupAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)
  potAccount  Account?           @relation("SplitGroupPot", fields: [potAccountId], references: [id], onDelete: SetNull)
  members     SplitGroupMember[]
  expenses    SharedExpense[]
  settlements SplitSettlement[]
  invites     SplitInvite[]
  contributions SplitContribution[]

  @@index([workspaceId, deletedAt])
}

/// One person on a group.
///
/// `personId` is null for exactly one member per group — the owner. Everybody
/// else is a `Person`, the same row the loan ledger uses, so a friend who is on
/// a trip *and* owes you money from last year appears once, with one balance.
model SplitGroupMember {
  id          String @id @default(cuid())
  workspaceId String
  groupId     String
  personId    String?
  /// True for the workspace owner's own line. Enforced one-per-group in code.
  isSelf      Boolean @default(false)
  /// Denormalised so a removed person still reads correctly on old expenses.
  displayName String
  /// The default weight for SHARES splits. Overridable per expense.
  shareWeight Int     @default(1)

  removedAt DateTime?
  createdAt DateTime  @default(now())

  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  group      SplitGroup           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  person     Person?              @relation(fields: [personId], references: [id], onDelete: Cascade)
  shares     SharedExpenseShare[]
  paidFor    SharedExpense[]      @relation("SharedExpensePayer")
  settledFrom SplitSettlement[]   @relation("SettlementFrom")
  settledTo   SplitSettlement[]   @relation("SettlementTo")
  invite      SplitInvite?
  mirrors     SplitMirror[]
  contributions SplitContribution[]
  /// Set when this member accepted an invitation: their own workspace, so a
  /// bill added here can reach their books as a draft.
  linkedWorkspaceId String?
  linkedUserId      String?

  @@unique([groupId, personId])
  @@index([workspaceId, groupId])
}

/// One bill that divided between people.
///
/// The owner's books carry only their own share as an expense; everybody else's
/// share is a receivable if the owner paid, or a payable if somebody else did.
/// `transactionId` is that entry, so the two can never drift apart — the same
/// rule `Loan.transactionId` follows.
model SharedExpense {
  id          String @id @default(cuid())
  workspaceId String
  groupId     String

  /**
   * Paid out of the group's pot rather than by one member.
   *
   * Changes what the owner's entries mean: their own share is spending, and the
   * rest of it discharges what they owe the other contributors, because the pot
   * was made of everybody's money.
   */
  fromPot Boolean @default(false)

  description String
  date        DateTime
  totalMinor  BigInt
  currency    String @default("BDT")

  payerMemberId String
  splitMethod   SplitMethod @default(EQUAL)
  /// Which household category the owner's own share is filed under, so a future
  /// budget reads shared spending the same way it reads everything else.
  categoryId    String?
  note          String?
  attachmentIds String[] @default([])

  /// The entry in the owner's ledger. Null only for a group whose owner was not
  /// involved in this particular bill.
  transactionId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  group       SplitGroup           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer       SplitGroupMember     @relation("SharedExpensePayer", fields: [payerMemberId], references: [id], onDelete: Cascade)
  mirrors     SplitMirror[]
  category    Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transaction Transaction?         @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  shares      SharedExpenseShare[]

  @@index([workspaceId, groupId, date])
  @@index([workspaceId, deletedAt])
}

/// What one member owes on one shared expense.
///
/// Stored rather than recomputed: the split method and its inputs can be edited
/// later, and a person's balance must be what they were told at the time, not
/// what today's rounding rule would produce.
model SharedExpenseShare {
  id          String @id @default(cuid())
  workspaceId String
  expenseId   String
  memberId    String

  /// The member's share of the bill, poisha. Always positive.
  amountMinor BigInt
  /// The input that produced it, kept so an edit can reopen the same form.
  percentBps  Int?
  shareWeight Int?

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  expense   SharedExpense      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member    SplitGroupMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([expenseId, memberId])
  @@index([workspaceId, memberId])
}

/// Money actually moving to clear a balance.
///
/// Separate from `SharedExpense` because it is not spending: nothing is
/// consumed, a debt is discharged. On the owner's side it posts cash against the
/// receivable or payable control account, which is what makes the balance go to
/// zero rather than merely *looking* settled.
model SplitSettlement {
  id          String @id @default(cuid())
  workspaceId String
  groupId     String

  fromMemberId String
  toMemberId   String
  amountMinor  BigInt
  date         DateTime
  /// The owner's cash/bank account, when the owner is one of the two sides.
  accountId    String?
  note         String?

  transactionId String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  group       SplitGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromMember  SplitGroupMember @relation("SettlementFrom", fields: [fromMemberId], references: [id], onDelete: Cascade)
  toMember    SplitGroupMember @relation("SettlementTo", fields: [toMemberId], references: [id], onDelete: Cascade)
  account     Account?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  transaction Transaction?     @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, groupId, date])
}

/// Where a shared bill stands in somebody else's books.
enum SplitMirrorStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// An invitation for a group member who has an account of their own.
///
/// The token is the credential and only its hash is stored, exactly as with
/// refresh tokens, email tokens and statement links. One invite per member: a
/// second one supersedes the first rather than both staying live.
model SplitInvite {
  id          String @id @default(cuid())
  /// The workspace doing the inviting.
  workspaceId String
  groupId     String
  memberId    String @unique

  tokenHash String    @unique
  expiresAt DateTime
  acceptedAt DateTime?
  acceptedByUserId    String?
  acceptedWorkspaceId String?
  revokedAt DateTime?

  createdByUserId String?
  createdAt       DateTime @default(now())

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  group     SplitGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member    SplitGroupMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([workspaceId, groupId])
}

/// One shared bill as it appears in the *other* person's books.
///
/// Nothing is written into somebody's ledger without them asking for it — the
/// rule the mailbox ingestion already follows. An accepted invite makes the
/// counterpart's share arrive here as a draft; they accept and it posts as their
/// expense and their payable, or they decline and the inviter's side is
/// unaffected either way.
model SplitMirror {
  id String @id @default(cuid())
  /// The workspace this draft belongs to — the invitee's, not the inviter's.
  workspaceId String
  /// The expense in the inviter's workspace that produced it.
  expenseId   String
  memberId    String

  description String
  date        DateTime
  amountMinor BigInt
  /// Whose bill it was, for the row's own sentence. Denormalised: the invitee
  /// cannot read the other workspace's rows and must still see a name.
  payerName   String
  groupName   String

  status      SplitMirrorStatus @default(PENDING)
  /// Set once accepted, so a draft can never post twice.
  transactionId String?  @unique
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  expense   SharedExpense    @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member    SplitGroupMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([expenseId, workspaceId])
  @@index([workspaceId, status, createdAt(sort: Desc)])
}


/// Money paid into a group's pot.
///
/// The owner's own contribution moves value between two of their accounts and
/// is not spending. Somebody else's grows the pot and grows what the holder
/// owes them — which is the whole reason a pot is not simply the holder's money.
model SplitContribution {
  id          String @id @default(cuid())
  workspaceId String
  groupId     String
  memberId    String

  amountMinor BigInt
  date        DateTime
  /// The account the owner's own contribution came out of.
  accountId   String?
  note        String?

  transactionId String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  group       SplitGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member      SplitGroupMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  account     Account?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  transaction Transaction?     @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, groupId, date])
}

/// A paper that expires.
///
/// A car needs a fitness certificate and a tax token every year; land carries
/// khajna, a flat holding tax, a business a trade licence. None of it is
/// bookkeeping — it is a calendar with money attached, and missing one costs a
/// fine, an impounded vehicle, or a mutation that will not go through.
///
/// Deliberately not modelled as a transaction: the obligation exists whether or
/// not it has been paid, and the payment when it happens is an ordinary expense
/// like any other.
model AssetObligation {
  id          String  @id @default(cuid())
  workspaceId String
  /// The asset it belongs to. Nullable because a passport and a trade licence
  /// belong to a person, not to a plot of land.
  accountId   String?

  /// `FITNESS`, `KHAJNA`, `TRADE_LICENCE` … see `RENEWAL_KINDS` in core.
  kind        String
  /// What this one is called. Free text, because the list is always missing one.
  title       String
  /// `YEARLY` | `HALF_YEARLY` | `QUARTERLY` | `MONTHLY` | `ONE_OFF`.
  recurrence  String  @default("YEARLY")

  /// The next one, as a local date. A deadline is a day, not an instant.
  dueDate     DateTime
  /// How much warning this one deserves. A passport needs more than a khajna.
  reminderLeadDays Int @default(30)
  /// So the year ahead can be totalled. The person's own estimate, never ours.
  estimatedCostMinor BigInt @default(0)

  /// What rolls the date forward, and the record that it was ever done.
  lastCompletedOn DateTime?
  /// Registration number, plot number, licence number. Masked like an account's.
  documentRef String?
  note        String?

  /// `YYYY-MM-DD` of the day a reminder last went out, in the workspace's own
  /// timezone. The idempotency guard the card reminders already use: a restart,
  /// an overlapping sweep or a second instance cannot send twice in a day.
  lastRemindedOn String?
  /// Muted without being deleted — the paper still exists.
  isMuted     Boolean @default(false)

  status      String  @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, dueDate])
  @@index([workspaceId, accountId])
}

// ---------------------------------------------------------------------------
// Income tax
// ---------------------------------------------------------------------------

/// One country's tax rules for one fiscal year, as a person transcribed them
/// from the Finance Act.
///
/// Global rather than workspace-scoped: the slabs are the same for everybody in
/// the country, and a copy per workspace would be an opportunity per workspace
/// to be wrong.
///
/// **Every rate column is nullable, and that is the design, not an oversight.**
/// A row exists for a fiscal year as soon as the year does, so the app can name
/// the year and say what it does not know. The figures arrive later, when
/// somebody has read the gazette and ticked `verified`. Until then
/// `estimateTax` in packages/core/src/tax.ts refuses to produce a number.
///
/// Falling back to the previous year was considered and rejected. A tax figure
/// computed on last year's slabs looks exactly like one computed on this year's,
/// and the person carrying it to their practitioner has no way to tell them
/// apart. The refusal is the feature — see docs/RENEWALS-AND-TAX.md §3.5.
model TaxRegime {
  id      String @id @default(cuid())
  /// ISO 3166-1 alpha-2. `BD` today; this column is what makes a second country
  /// a data exercise rather than a release.
  country String

  /// `2025-26`, named exactly as `fiscalYearOf` in @hishab/core names it.
  fiscalYear      String
  /// Inclusive `YYYY-MM-DD` bounds, stored as text rather than as timestamps.
  /// A fiscal year boundary is a date in law, not an instant: 30 June is 30 June
  /// in Dhaka, in UTC, and on a server in Frankfurt. A TIMESTAMP would invite
  /// precisely the off-by-one that buckets a 1 July salary into the wrong year.
  fiscalYearStart String
  fiscalYearEnd   String

  /// A correction writes a new row; it never edits an old one. A worksheet
  /// printed last week was computed from some particular set of figures, and
  /// overwriting them in place would make that sheet unexplainable. The service
  /// reads the highest version for a country and year.
  version Int @default(1)

  /// `TaxSlab[]` — `[{ fromMinor, rateBps }]`, ascending. Null until transcribed.
  slabs               Json?
  /// `Record<string, number>` — the tax-free threshold per taxpayer category.
  /// General, women, 65+, disabled, gazetted freedom fighter, third gender.
  thresholdByCategory Json?
  /// `RebateRule` — `{ rateOfInvestmentBps, capShareOfIncomeBps, capAbsoluteMinor }`.
  rebate              Json?
  /// `Record<string, number>` — the minimum tax by where the taxpayer lives.
  minimumTaxByArea    Json?
  /// `SurchargeBand[]` — `[{ fromMinor, rateBps }]` on net wealth.
  surchargeBands      Json?

  /// "Finance Act 2025, s.—", printed beside every figure this row produces.
  /// Never empty: a row that cannot say where it came from cannot be checked.
  sourceCitation   String
  /// False until a person has checked every figure above against the gazette.
  /// Nothing computes without it.
  verified         Boolean   @default(false)
  verifiedAt       DateTime?
  /// Deliberately not a foreign key to `User`. The provenance of a verified tax
  /// year has to outlive the account of whoever verified it — somebody closing
  /// their account must not blank the answer to "who checked these numbers?" —
  /// and either a cascade or a SET NULL would do exactly that.
  verifiedByUserId String?
  /// The verifier's name as it stood at the time, for the same reason.
  verifiedByName   String?
  /// Anything the verifier wants the next person reading this row to know.
  verificationNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([country, fiscalYear, version])
  @@index([country, fiscalYear, verified])
}

/// What the tax computation needs to know about the taxpayer and the ledger
/// cannot tell it.
///
/// One per workspace, and it holds no money: the slab a person starts on depends
/// on whether they are a woman, over 65, disabled, a gazetted freedom fighter or
/// third gender, and the minimum tax depends on which city they live in. Neither
/// fact is derivable from a transaction.
///
/// `category` and `area` are free text rather than enums on purpose. Which
/// categories and areas exist is a fact about the Finance Act, not about this
/// schema, and an enum here would need a migration every year the Act adds one.
/// They are validated at computation time against the year's own regime — the
/// only place that knows.
model TaxProfile {
  id          String @id @default(cuid())
  workspaceId String @unique
  country     String @default("BD")

  /// A key of the regime's `thresholdByCategory`. Defaults to the general
  /// taxpayer, which is the only category that is safe to assume.
  category         String  @default("general")
  /// A key of the regime's `minimumTaxByArea`.
  area             String  @default("elsewhere")
  /// Whether this person has to file at all. Shown on the worksheet, because a
  /// practitioner reading it needs to know; not yet an input to the arithmetic.
  isRequiredToFile Boolean @default(true)
  /// The last digits at most, masked like `accountNumberMasked`. A TIN is a
  /// national identifier and this product has no use for the whole of one.
  tinMasked        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}
