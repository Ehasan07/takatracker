// Hishab — server schema.
//
// Money is ALWAYS BigInt poisha (1/100 BDT). No Float or Decimal anywhere.
//
// Tenancy: every row that belongs to a customer carries `workspaceId`, and that
// column — never `userId` — is what the repository layer filters on. `userId`
// survives only where it records *who did something*. See docs/PLAN.md §3.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?
  passwordHash String
  name         String
  /// Display language. Currency and the ledger day belong to the workspace.
  locale       String   @default("bn")
  /// When to deliver reminders to this person, which need not match the
  /// workspace's accounting timezone.
  notifyTimezone String @default("Asia/Dhaka")
  /// null until the address is proven. Unverified accounts still work — locking
  /// somebody out of their own books over an undelivered email is worse than
  /// the risk — but the nag stays until this is set.
  emailVerifiedAt DateTime?
  /// Bumped whenever every session must die — a password reset, an admin
  /// lockout. Access tokens carry the value they were minted with, so a stolen
  /// one stops working the moment this moves rather than surviving its
  /// remaining fifteen minutes. Refresh families are revoked separately; this
  /// closes the access-token window they cannot reach.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships      Membership[]
  emailTokens      EmailToken[]
  ownedWorkspaces  Workspace[]    @relation("WorkspaceOwner")
  createdTxns      Transaction[]  @relation("TransactionAuthor")
  refreshTokens    RefreshToken[]
  sentInvitations  Invitation[]   @relation("InvitationSender")
  telegram         TelegramConnection[]
  auditEvents      AuditEvent[]         @relation("AuditActor")
}

/// Rotating refresh tokens. A whole family is revoked when a used token is
/// replayed (reuse detection, spec §9). A session belongs to a person, not to
/// a tenant, so this table has no `workspaceId`.
model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  familyId   String
  tokenHash  String    @unique
  deviceId   String?
  userAgent  String?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  usedAt     DateTime?
  revokedAt  DateTime?
  replacedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([expiresAt])
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// One-shot links sent by email.
///
/// Only the hash is stored, exactly as with refresh tokens: a leaked database
/// must not hand somebody a working password-reset link. Rows are kept after
/// use so a replay can be told apart from an expired link, which changes what
/// the user is told.
model EmailToken {
  id        String            @id @default(cuid())
  userId    String
  purpose   EmailTokenPurpose
  tokenHash String            @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())
  /// Where it was requested from, for the audit trail on a reset.
  requestIp String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Plans & entitlements
//
// What each plan includes lives in `packages/core/entitlements.ts`, not here.
// The API upserts these rows from that definition at boot, so changing a tier
// is a pull request rather than a schema change.
// ---------------------------------------------------------------------------

enum BillingInterval {
  MONTHLY
  YEARLY
}

model Plan {
  id         String          @id @default(cuid())
  code       String          @unique
  name       String
  /// Integer poisha, like every other amount in the system.
  priceMinor BigInt          @default(0)
  currency   String          @default("BDT")
  interval   BillingInterval @default(MONTHLY)
  isPublic   Boolean         @default(true)
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  features   PlanFeature[]
  workspaces Workspace[]
}

model PlanFeature {
  id         String @id @default(cuid())
  planId     String
  featureKey String
  /// null = unlimited. For a flag, 0 is off.
  limitValue Int?

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
}

/// A per-workspace grant or restriction that beats the plan. Support uses this
/// to hand out an owner-only feature, or to widen a limit temporarily.
model WorkspaceFeatureOverride {
  id          String    @id @default(cuid())
  workspaceId String
  featureKey  String
  limitValue  Int?
  expiresAt   DateTime?
  note        String?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, featureKey])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

enum WorkspaceStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

/// The tenant. One per account today; the model exists so household and team
/// sharing is a feature flag later rather than a migration.
model Workspace {
  id           String          @id @default(cuid())
  name         String
  ownerUserId  String
  planId       String?
  status       WorkspaceStatus @default(ACTIVE)
  /// Base currency for every amount in this workspace.
  currency     String          @default("BDT")
  /// Defines the ledger day. All date arithmetic resolves against this.
  timezone     String          @default("Asia/Dhaka")
  trialEndsAt  DateTime?
  /// Days of notice before a credit-card due date, unless a card overrides it.
  creditCardReminderLeadDays Int     @default(7)
  /// Recording money into a card mutes that cycle. On by default; the manual
  /// control stays either way.
  autoMuteOnCardPayment      Boolean @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?

  owner        User          @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  plan         Plan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  overrides    WorkspaceFeatureOverride[]
  memberships  Membership[]
  invitations  Invitation[]
  telegram     TelegramConnection[]
  cardCycles   CardReminderCycle[]
  auditEvents  AuditEvent[]
  loans        Loan[]
  loanPayments LoanPayment[]
  importBatches ImportBatch[]
  ingestionMessages IngestionMessage[]
  transactionDrafts TransactionDraft[]
  savingsPlans SavingsPlan[]
  savingsInstallments SavingsInstallment[]
  policies     InsurancePolicy[]
  premiums     PremiumPayment[]
  accounts     Account[]
  categories   Category[]
  people       Person[]
  transactions Transaction[]
  entries      LedgerEntry[]

  @@index([ownerUserId])
  @@index([status])
  @@index([planId])
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

model Membership {
  id          String           @id @default(cuid())
  workspaceId String
  userId      String
  role        MembershipRole   @default(OWNER)
  invitedBy   String?
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, status])
}

model Invitation {
  id          String         @id @default(cuid())
  workspaceId String
  email       String
  role        MembershipRole @default(MEMBER)
  tokenHash   String         @unique
  invitedBy   String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sender    User?     @relation("InvitationSender", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@index([workspaceId, email])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Accounts & categories
// ---------------------------------------------------------------------------

enum AccountType {
  CASH
  BANK
  MOBILE_WALLET
  CREDIT_CARD
  SAVINGS
  RECEIVABLE
  PAYABLE
  ASSET
  LIABILITY
  EQUITY
}

model Account {
  id                  String      @id @default(cuid())
  workspaceId         String
  name                String
  type                AccountType
  currency            String      @default("BDT")
  openingBalance      BigInt      @default(0)
  institution         String?
  accountNumberMasked String?
  matchHints          String[]    @default([])
  isArchived          Boolean     @default(false)
  sortOrder           Int         @default(0)
  icon                String?
  color               String?
  /// Set only on the hidden nominal accounts (SYSTEM_INCOME / SYSTEM_EXPENSE /
  /// SYSTEM_EQUITY) that make the double entry balance. Never shown in the UI.
  systemKey           String?
  /// Credit cards only. 1–31; a due day past the end of a short month is
  /// clamped to its last day, so the 31st is the 28th in February.
  statementDayOfMonth Int?
  dueDayOfMonth       Int?
  /// null falls back to the workspace default.
  reminderLeadDays    Int?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  deletedAt           DateTime?

  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries        LedgerEntry[]
  reminderCycles CardReminderCycle[]
  loansFunded    Loan[]              @relation("LoanCashAccount")
  loanControl    Loan?               @relation("LoanControlAccount")
  loanPayments   LoanPayment[]

  @@unique([workspaceId, systemKey])
  @@index([workspaceId, isArchived, sortOrder])
}

enum CategoryKind {
  INCOME
  EXPENSE
}

model Category {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  nameBn      String?
  parentId    String?
  kind        CategoryKind
  icon        String?
  color       String?
  isSystem    Boolean      @default(false)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[]    @relation("CategoryTree")
  entries   LedgerEntry[]

  @@index([workspaceId, kind, sortOrder])
}

model Person {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  phone       String?
  relation    String?
  note        String?
  photoUri    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  loans        Loan[]

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

enum AuditActorType {
  USER
  SYSTEM
  SUPPORT
  INTEGRATION
}

/// Append-only. Nothing in the application updates or deletes a row here, and
/// no query ever crosses a workspace boundary (v3 §A3). Bodies of inbound
/// messages are never recorded — only that something happened, to what.
model AuditEvent {
  id           String         @id @default(cuid())
  workspaceId  String
  actorUserId  String?
  actorType    AuditActorType @default(USER)
  action       String
  entity       String?
  entityId     String?
  before       Json?
  after        Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, action])
  @@index([workspaceId, entity, entityId])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum TelegramMode {
  /// The official Hishab bot. We store a chat id, which is an address, not a
  /// secret — no per-user credential to guard.
  SHARED_BOT
  /// The member brought their own bot. Its token is a credential and is
  /// handled exactly like an IMAP password (v3 §C6).
  OWN_BOT
}

enum TelegramStatus {
  PENDING
  ACTIVE
  AUTH_FAILED
  DISABLED
  REVOKED
}

model TelegramConnection {
  id          String         @id @default(cuid())
  workspaceId String
  userId      String
  mode        TelegramMode   @default(SHARED_BOT)
  /// Null until the binding handshake completes.
  chatId      String?
  /// Only ever set in OWN_BOT mode. Points at the secret store; the token
  /// itself is never in this table and never in an API response.
  botTokenRef String?
  botUsername String?
  /// Single-use, hashed, short-lived. Matched when Telegram delivers /start.
  bindingTokenHash String?
  bindingExpiresAt DateTime?
  isEnabled   Boolean        @default(false)
  verifiedAt  DateTime?
  status      TelegramStatus @default(PENDING)
  failureCount Int           @default(0)
  lastError   String?
  lastSentAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  revokedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@unique([bindingTokenHash])
  @@index([status])
}

enum CardMuteReason {
  MANUAL
  PAID
}

/// One row per card per billing cycle. Muting writes to the current row, so the
/// next month is a fresh row and reminders resume with no un-mute job.
model CardReminderCycle {
  id            String          @id @default(cuid())
  workspaceId   String
  accountId     String
  /// `YYYY-MM`
  cycleMonth    String
  dueDate       DateTime
  windowStart   DateTime
  windowEnd     DateTime
  mutedAt       DateTime?
  mutedByUserId String?
  mutedReason   CardMuteReason?
  /// `YYYY-MM-DD` in the workspace timezone. The idempotency guard: a worker
  /// restart must never send twice in one day.
  lastSentOn    String?
  sentCount     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, cycleMonth])
  @@index([workspaceId, cycleMonth])
}

// ---------------------------------------------------------------------------
// People & lending
// ---------------------------------------------------------------------------

enum LoanDirection {
  LENT
  BORROWED
}

enum LoanInterestType {
  NONE
  FIXED
  PERCENT
}

enum LoanStatus {
  ACTIVE
  COMPLETED
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK
  MOBILE_WALLET
  CHEQUE
  CARD
  OTHER
}

/// A loan given or taken.
///
/// The money itself lives in the ordinary double-entry ledger, exactly as it
/// would in QuickBooks: every loan owns a control account (RECEIVABLE when we
/// lent, PAYABLE when we borrowed) and disbursement and repayment are plain
/// transfers between that control account and a cash or bank account. So the
/// balance sheet, the cash flow statement and the running balance on the
/// account statement all pick loans up with no special-casing, and no loan
/// movement is ever counted as income or expense.
///
/// This table therefore holds only what the ledger cannot: the loan number, the
/// counterparty, the agreed terms and the due date.
model Loan {
  id          String @id @default(cuid())
  workspaceId String
  /// Human-facing, unique per workspace: L-0001, L-0002, …
  loanNumber  String
  personId    String
  direction   LoanDirection

  principalMinor BigInt
  /// Off by default: most household lending in Bangladesh carries no interest.
  interestType   LoanInterestType @default(NONE)
  /// A single agreed sum when interestType is FIXED, poisha.
  interestMinor  BigInt           @default(0)
  /// Annual rate in basis points when interestType is PERCENT: 8.25% is 825.
  interestRateBps Int             @default(0)

  loanDate DateTime
  dueDate  DateTime?

  /// The cash or bank account the principal moved through.
  accountId     String
  /// The RECEIVABLE or PAYABLE control account this loan owns.
  loanAccountId String  @unique
  /// The disbursement transaction, so the two can never drift apart.
  transactionId String?

  note          String?
  attachmentIds String[]   @default([])
  status        LoanStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  person      Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  account     Account       @relation("LoanCashAccount", fields: [accountId], references: [id], onDelete: Restrict)
  loanAccount Account       @relation("LoanControlAccount", fields: [loanAccountId], references: [id], onDelete: Restrict)
  payments    LoanPayment[]

  @@unique([workspaceId, loanNumber])
  @@index([workspaceId, status])
  @@index([workspaceId, direction, status])
  @@index([workspaceId, personId])
  @@index([workspaceId, dueDate])
}

/// One instalment against a loan. Immutable once written: a correction is a new
/// row, never an edit, so the payment history stays an audit trail.
model LoanPayment {
  id          String @id @default(cuid())
  workspaceId String
  loanId      String

  date            DateTime
  amountMinor     BigInt
  method          PaymentMethod @default(CASH)
  referenceNumber String?
  note            String?
  attachmentIds   String[]      @default([])

  /// The cash or bank account the instalment moved through.
  accountId     String
  /// The transfer this payment booked.
  transactionId String?

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  loan      Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([workspaceId, loanId, date])
  @@index([workspaceId, referenceNumber])
}

// ---------------------------------------------------------------------------
// Savings & insurance
// ---------------------------------------------------------------------------

enum SavingsPlanType {
  DPS
  FDR
  SANCHAYPATRA
  RECURRING_DEPOSIT
  GOAL_SAVINGS
}

enum ProfitCalc {
  SIMPLE
  COMPOUND_MONTHLY
  COMPOUND_QUARTERLY
  COMPOUND_YEARLY
}

enum PlanFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum SavingsStatus {
  ACTIVE
  MATURED
  CLOSED
}

enum InstalmentStatus {
  DUE
  PAID
  MISSED
  SKIPPED
}

model SavingsPlan {
  id              String          @id @default(cuid())
  workspaceId     String
  institution     String?
  planName        String
  planType        SavingsPlanType @default(DPS)
  /// One instalment, in poisha. Zero for a lump-sum FDR.
  installmentMinor BigInt         @default(0)
  /// The lump sum an FDR or Sanchayapatra starts with.
  principalMinor  BigInt          @default(0)
  frequency       PlanFrequency   @default(MONTHLY)
  termMonths      Int
  startDate       DateTime
  maturityDate    DateTime?
  /// Annual rate in basis points, so 8.25% is 825 — the user types the rate
  /// their bank advertises and we never infer it.
  profitRateBps   Int             @default(0)
  profitCalc      ProfitCalc      @default(COMPOUND_YEARLY)
  linkedAccountId String?
  status          SavingsStatus   @default(ACTIVE)
  note            String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installments SavingsInstallment[]

  @@index([workspaceId, status])
}

model SavingsInstallment {
  id            String           @id @default(cuid())
  workspaceId   String
  planId        String
  dueDate       DateTime
  expectedMinor BigInt
  paidDate      DateTime?
  transactionId String?
  status        InstalmentStatus @default(DUE)

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      SavingsPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, dueDate])
  @@index([workspaceId, status, dueDate])
}

enum PolicyStatus {
  ACTIVE
  LAPSED
  MATURED
  CANCELLED
}

model InsurancePolicy {
  id                  String        @id @default(cuid())
  workspaceId         String
  insurer             String
  policyNumberMasked  String?
  policyType          String?
  sumAssuredMinor     BigInt        @default(0)
  premiumMinor        BigInt        @default(0)
  frequency           PlanFrequency @default(YEARLY)
  startDate           DateTime
  maturityDate        DateTime?
  nomineeName         String?
  status              PolicyStatus  @default(ACTIVE)
  note                String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  premiums  PremiumPayment[]

  @@index([workspaceId, status])
}

model PremiumPayment {
  id            String           @id @default(cuid())
  workspaceId   String
  policyId      String
  dueDate       DateTime
  amountMinor   BigInt
  paidDate      DateTime?
  transactionId String?
  status        InstalmentStatus @default(DUE)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  policy    InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, dueDate])
  @@index([workspaceId, status, dueDate])
}

// ---------------------------------------------------------------------------
// Ledger
// ---------------------------------------------------------------------------

enum ImportStatus {
  PENDING
  APPLIED
  REVERTED
}

/// One spreadsheet upload.
///
/// Imports are recorded as a batch so the whole thing can be undone in one
/// action. Somebody who maps a column wrong and lands two hundred rows in the
/// wrong account needs one button, not two hundred deletions.
model ImportBatch {
  id          String       @id @default(cuid())
  workspaceId String
  createdByUserId String?
  filename    String
  /// SHA-256 of the uploaded bytes, so the same file offered twice can be
  /// spotted before it doubles somebody's books.
  fileHash    String
  /// The column mapping the user chose, kept so the next import of the same
  /// export can reuse it.
  mapping     Json
  rowCount    Int          @default(0)
  importedCount Int        @default(0)
  skippedCount  Int        @default(0)
  status      ImportStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  appliedAt   DateTime?
  revertedAt  DateTime?

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, fileHash])
}

enum IngestionChannel {
  SMS
  EMAIL
  WEBHOOK
}

enum DraftStatus {
  PENDING
  ACCEPTED
  REJECTED
  DUPLICATE
}

/// A message that arrived from outside — a bank SMS, an email alert, a webhook.
///
/// The raw body is kept because a parser that gets something wrong can only be
/// fixed against the text that broke it. It is also the deduplication key: the
/// same alert delivered twice must produce one draft, not two.
model IngestionMessage {
  id          String           @id @default(cuid())
  workspaceId String
  channel     IngestionChannel
  /// Sender address, shortcode or webhook source.
  sender      String?
  receivedAt  DateTime
  body        String
  /// SHA-256 of channel + sender + body, unique per workspace.
  bodyHash    String
  /// Whatever the parser produced, kept for debugging a bad parse.
  parsed      Json?
  parserName  String?
  createdAt   DateTime         @default(now())

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  drafts    TransactionDraft[]

  @@unique([workspaceId, bodyHash])
  @@index([workspaceId, receivedAt(sort: Desc)])
}

/// A proposed transaction awaiting a human.
///
/// Nothing an SMS parser produces reaches the ledger on its own. The draft
/// carries a confidence score and the exact span of text each field came from,
/// so the review screen can show its working rather than asking for blind trust.
model TransactionDraft {
  id          String      @id @default(cuid())
  workspaceId String
  messageId   String?
  status      DraftStatus @default(PENDING)

  date        DateTime?
  amountMinor BigInt?
  direction   String?
  payee       String?
  accountId   String?
  categoryId  String?
  /// 0–100. Below the review threshold the draft is shown but never applied.
  confidence  Int         @default(0)
  /// Field name to the substring it was read from, for the "why" popover.
  evidence    Json?

  /// Set once accepted, so a draft can never be applied twice.
  transactionId String?  @unique
  reviewedAt    DateTime?
  reviewedByUserId String?
  createdAt     DateTime @default(now())

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  message   IngestionMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, createdAt(sort: Desc)])
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  LOAN_GIVEN
  LOAN_REPAID
  BORROWED
  BORROW_REPAID
  SAVINGS_DEPOSIT
  SAVINGS_WITHDRAWAL
  PREMIUM_PAID
  ADJUSTMENT
  OPENING_BALANCE
}

enum TransactionSource {
  MANUAL
  SMS
  EMAIL
  WEBHOOK
  OCR
  IMPORT
  RECURRING
}

model Transaction {
  id            String            @id @default(cuid())
  workspaceId   String
  /// Who entered it. Matters once a workspace has more than one member.
  createdByUserId String?
  date          DateTime
  type          TransactionType
  description   String?
  notes         String?
  payee         String?
  personId      String?
  projectTag    String?
  attachmentIds String[]          @default([])
  source        TransactionSource @default(MANUAL)
  sourceDraftId String?
  importBatchId String?
  externalRef   String?
  /// Device-generated UUID so offline rows keep identity across sync (§8).
  clientId      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User?         @relation("TransactionAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)
  person      Person?      @relation(fields: [personId], references: [id], onDelete: SetNull)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  entries     LedgerEntry[]

  @@unique([workspaceId, clientId])
  @@index([workspaceId, date(sort: Desc)])
  @@index([workspaceId, type])
  @@index([workspaceId, source])
  @@index([workspaceId, externalRef])
  @@index([workspaceId, importBatchId])
}

enum EntryDirection {
  DEBIT
  CREDIT
}

model LedgerEntry {
  id            String         @id @default(cuid())
  /// Denormalised from the transaction so balance aggregation does not need a
  /// join. A database trigger keeps the two in step — see the migration.
  workspaceId   String
  transactionId String
  accountId     String
  categoryId    String?
  /// Always positive; `direction` carries the sign.
  amountMinor   BigInt
  direction     EntryDirection
  currency      String         @default("BDT")
  /// 1 for BDT-only v1. Kept so multi-currency is a data change, not a migration.
  fxRate        Int            @default(1)

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  // Cascade so deleting a workspace removes its whole ledger. Account deletion
  // is never offered in the UI (accounts are archived); this exists so the
  // "delete my account and all my data" store requirement actually works.
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([workspaceId, accountId])
  @@index([workspaceId, categoryId])
}
