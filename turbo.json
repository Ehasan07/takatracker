{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "JWT_ACCESS_SECRET",
    "JWT_REFRESH_SECRET",
    "NEXT_PUBLIC_API_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    // Cacheable, and correctly so: packages/core, packages/shared,
    // packages/parsers and apps/web run pure in-process tests, so the hash of
    // their own files plus their dependencies' build outputs is a complete
    // description of what was tested. Replaying that is the point of turbo.
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    // Not cacheable, and it must stay that way: @hishab/api's suite is
    // integration, not unit. It boots Nest against a live PostgreSQL, truncates
    // every table and asserts on database triggers and constraints — state
    // turbo cannot see, cannot hash, and therefore cannot know is unchanged. A
    // cache hit here prints "13 suites, 149 tests passed" without a database
    // having been touched, so a dropped migration, a stale schema or a Postgres
    // that is not even running reports green. `pnpm test` is the evidence
    // behind every quality claim in this repo; evidence that can be replayed
    // from disk is not evidence. Package-task config replaces the generic
    // entry rather than merging with it, hence the repeated dependsOn.
    "@hishab/api#test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:e2e": {
      /* `^build` is the *web* package's own dependencies, which do not include
       * the API — so Playwright's webServer was starting `node dist/main.js`
       * against whatever build happened to be sitting on disk. A run could
       * exercise an API from days ago and still report green, and one did:
       * a new module's routes 404'd because dist predated them.
       *
       * Naming the API explicitly makes the browser suite test the code in the
       * working tree, which is the only thing it was ever supposed to prove. */
      "dependsOn": ["^build", "@hishab/api#build"],
      "cache": false
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
